# CivicVision AI — Backend Environment Configuration

PROJECT_NAME="CivicVision AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Computer Vision / ML Feature Flags (Disabled by default)
ENABLE_IRDID_CLASSIFIER=false

# Computer Vision Confidence Thresholds (Evidence-based defaults)
YOLO_CONFIDENCE_THRESHOLD=0.25
IRDID_CLASSIFIER_THRESHOLD=0.30

# JWT Auth Secret Key (Change in production)
SECRET_KEY="civicvision_ai_super_secret_jwt_key_2026_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite Database Configuration (Project exclusively uses SQLite)
DATABASE_URL="sqlite:///./civicsense.db"

# Upload Limits (10 MiB in bytes)
MAX_UPLOAD_SIZE_BYTES=10485760

# Engine Parameters
WEIGHT_CATEGORY=0.35
WEIGHT_CONFIDENCE=0.15
WEIGHT_DEFECT_AREA=0.15
WEIGHT_DUPLICATES=0.20
WEIGHT_AGING=0.15

DUPLICATE_RADIUS_METERS=50.0
DUPLICATE_TIME_WINDOW_HOURS=72.0
